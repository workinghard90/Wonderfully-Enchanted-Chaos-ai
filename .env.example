# Documentation template only: .env is NOT automatically loaded.
# Export these in your shell or configure them in your hosting platform.
# Required with 32+ characters when binding outside loopback. Generate your own.
WEC_STUDIO_TOKEN=
# Default: ~/.wec-studio. Use a durable mounted directory when hosted.
WEC_DATA_DIR=
# Optional, only for a separate static frontend. Bare HTTPS origin, no trailing /.
WEC_FRONTEND_ORIGIN=
# Optional local/private ComfyUI worker, default http://127.0.0.1:8188.
WEC_COMFY_URL=http://127.0.0.1:8188
# Limit FFmpeg encoder threads. Default 2.
WEC_FFMPEG_THREADS=2
# Custom cloud IMAGE gateway contract, not a built-in commercial provider.
# Used only by explicit `wec generate --cloud --cloud-estimate ... --cloud-budget ...`.
WEC_CLOUD_ENDPOINT=
WEC_CLOUD_API_KEY=

# Optional studio image generation. OFF unless exactly 1 and credentials are valid.
# Use a Cloudflare Workers Free account; keep credentials in host secret settings.
WEC_ENABLE_IMAGE_GENERATION=0
WEC_CLOUDFLARE_ACCOUNT_ID=
WEC_CLOUDFLARE_API_TOKEN=
